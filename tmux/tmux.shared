# shared amongst all tmux

# VI keybindings please
setw -g mode-keys vi

set -g default-terminal "screen-256color"

# show messages for 4 seconds
set-option -g display-time 1000

# Enable mouse support
set -g mouse on

# Improve mouse wheel scrolling
bind-key -T copy-mode-vi WheelUpPane send-keys -X scroll-up
bind-key -T copy-mode-vi WheelDownPane send-keys -X scroll-down

# Modern VI-like copy/paste with mouse integration
unbind [
bind Escape copy-mode
unbind p
bind p paste-buffer

# Modern copy-mode bindings (tmux >= 2.4)
bind-key -T copy-mode-vi 'v' send -X begin-selection
bind-key -T copy-mode-vi 'V' send -X select-line
bind-key -T copy-mode-vi 'r' send -X rectangle-toggle
bind-key -T copy-mode-vi 'y' send -X copy-pipe-and-cancel 'pbcopy'  # Copy to macOS clipboard
bind-key -T copy-mode-vi MouseDragEnd1Pane send -X copy-pipe-and-cancel 'pbcopy'  # Mouse selection to clipboard

# Middle click to paste from clipboard
bind-key -n MouseDown2Pane run "tmux set-buffer \"$(pbpaste)\"; tmux paste-buffer"

# Double click to select word and copy to clipboard
bind-key -T copy-mode-vi DoubleClick1Pane select-pane \; send -X select-word \; send -X copy-pipe-no-clear "pbcopy"
bind-key -n DoubleClick1Pane select-pane \; copy-mode -M \; send -X select-word \; send -X copy-pipe-no-clear "pbcopy"

# Triple click to select line and copy to clipboard
bind-key -T copy-mode-vi TripleClick1Pane select-pane \; send -X select-line \; send -X copy-pipe-no-clear "pbcopy"
bind-key -n TripleClick1Pane select-pane \; copy-mode -M \; send -X select-line \; send -X copy-pipe-no-clear "pbcopy"

# when sharing a session, don't lock entire session to shared screen size
setw -g aggressive-resize on

# VI for splitting
bind s split-window -v
bind v split-window -h

# VI for switching between
bind h select-pane -L
bind j select-pane -D
bind k select-pane -U
bind l select-pane -R

# make it easy to grab a pane and put it into the current window
bind-key @ command-prompt -p "create pane from:"  "join-pane -s ':%%'"

# better parent/children window layouts
bind-key ] select-layout main-vertical \; resize-pane -t 1 -x 80 \; display-message "Children right."
bind-key [ select-layout main-horizontal \; resize-pane -t 1 -y 13 \; display-message "Children bottom."

# binding to clear activity alerts
bind-key C run-shell tmux-clear-activity

# easily toggle synchronization (mnemonic: e is for echo)
bind e setw synchronize-panes on
bind E setw synchronize-panes off

# switch " over to selecting windows
unbind '"'
bind-key '"' choose-window

# use ' to switch between sessions
bind-key "'" choose-session

# number windows from 1
set -g base-index 1

# don't wait after escape
set -s escape-time 0

## setting up status bar
## mostly horked from http://www.linuxized.com/2010/05/switching-from-gnu-screen-to-tmux/

# set-option -g status-justify centre
set-option -g status-justify left
set-option -g status-bg colour16
set-option -g status-fg white
set-option -g status-left-length 40

# Modern window status styling (tmux >= 2.9)
setw -g window-status-style bg=colour16,fg=white
setw -g window-status-current-style fg=colour46
setw -g window-status-activity-style default,fg=colour192,bg=colour16

# monitor activity
setw -g monitor-activity on
set -g visual-activity off

bind m setw monitor-activity off
bind M setw monitor-activity on

set -g status-left '#[fg=green][ #[fg=red]#H#[fg=green]:#[fg=white]#S #[fg=green]][#[default]'
#set -g status-right '#[fg=green]][#[fg=white] #T #[fg=green]][ #[fg=blue]%Y-%m-%d #[fg=white]%H:%M#[default]'
#set -g status-right '#[fg=green]][ #[fg=blue]%Y-%m-%d #[fg=white]%H:%M#[default]'
set -g status-right '#[fg=green]]'


set -g update-environment "DISPLAY SSH_ASKPASS SSH_AGENT_PID SSH_CONNECTION WINDOWID XAUTHORITY SSH_AUTH_SOCK"
